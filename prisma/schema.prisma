generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  student
  admin
}

model user {
  id String @id @default(uuid())

  fullName String
  email    String @unique
  password String

  role Role @default(student)

  catgptconversations catgptconversation[]

  studentprofile     studentprofile?
  chats              chat[]
  profileevaluations profileevaluation[]
  studyplans         studyplan[]
  studyTasks         StudyTask[]
  collegepredictions collegeprediction[]
  tasks              task[]
  mockTests          MockTest[]
  topicPerformance   TopicPerformance[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model studentprofile {
  id String @id @default(cuid())

  userid String @unique
  user   user   @relation(fields: [userid], references: [id])

  // Basic Details
  educationstage      String?
  reservationcategory String?
  gender              String?

  // Academics
  tenthpercentage   Float?
  twelfthpercentage Float?
  graduationscore   Float?
  graduationstream  String?

  // Experience
  isexperienced        Boolean @default(false)
  experiencemonths     Int?
  internshipcount      Int?
  currentrole          String?
  leadershipexperience Boolean @default(false)

  // Extra Profile
  certifications       String?
  leadershipactivities String?
  competitions         String?

  // MBA Goals
  targetexam       String?
  attemptyear      Int?
  targetpercentile Float?
  targetcolleges   String?

  // Study
  weakareas       String?
  dailystudyhours Int?

  createdat DateTime @default(now())
  updatedat DateTime @updatedAt
}

model chat {
  id String @id @default(cuid())

  userid String
  user   user   @relation(fields: [userid], references: [id])

  message  String @db.Text
  response String @db.Text

  createdat DateTime @default(now())
}

model profileevaluation {
  id String @id @default(cuid())

  userid String
  user   user   @relation(fields: [userid], references: [id])

  overallscore Int

  profilesummary String @db.Text

  academicanalysis String @db.Text

  workexperienceanalysis String @db.Text

  achievementsanalysis String @db.Text

  examreadiness String @db.Text

  collegesuitability Json

  gapanalysis String @db.Text

  roadmap String @db.Text

  airecommendations String @db.Text

  createdat DateTime @default(now())

  updatedat DateTime @updatedAt
}

model studyplan {
  id String @id @default(cuid())

  userid String
  user   user   @relation(fields: [userid], references: [id])

  targetexam       String
  targetpercentile Float
  targetcolleges    String?
  attemptyear       String?
  examdate         DateTime

  roadmap      String @db.Text
  monthlyplan  String @db.Text
  weeklyplan   String @db.Text
  dailytasks   String @db.Text
  revisionplan String @db.Text

  studyTasks StudyTask[]


  createdat DateTime @default(now())
}

model collegeprediction {
  id String @id @default(cuid())

  userid String
  user   user   @relation(fields: [userid], references: [id])

  percentile Float

  dream  Json
  target Json
  safe   Json

  analysis String? @db.Text

  createdat DateTime @default(now())
}

model College {
  id String @id @default(cuid())

  name String

  shortName String?

  city String

  state String

  type String

  establishedYear Int?

  nirfRank Int?

  fees Float?

  avgPackage Float?

  highestPackage Float?

  officialWebsite String?

  seats Int?

  imageUrl String?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  cutoffs CollegeCutoff[]
}

model task {
  id String @id @default(cuid())

  userid String
  user   user   @relation(fields: [userid], references: [id])

  title       String
  description String?

  priority String @default("medium")

  status String @default("pending")

  duedate DateTime?

  createdat DateTime @default(now())
  updatedat DateTime @updatedAt
}

model CollegeCutoff {
  id String @id @default(cuid())

  collegeId String

  college College @relation(fields: [collegeId], references: [id], onDelete: Cascade)

  exam String

  year Int

  category String

  gender String?

  academicBackground String?

  overallPercentile Float

  varcCutoff Float?

  dilrCutoff Float?

  qaCutoff Float?

  createdAt DateTime @default(now())
}

model document {
  id String @id @default(cuid())

  title    String
  category String

  filename String
  filepath String

  createdat DateTime @default(now())
}

model adminprompt {
  id String @id @default(cuid())

  name       String
  prompttext String @db.Text

  createdat DateTime @default(now())
  updatedat DateTime @updatedAt
}

model catgptconversation {
  id String @id @default(cuid())

  userid String
  user   user   @relation(fields: [userid], references: [id])

  question String @db.Text

  answer String @db.Text

  createdat DateTime @default(now())
}

model MockTest {
  id String @id @default(cuid())

  userId String
  user   user   @relation(fields: [userId], references: [id], onDelete: Cascade)

  exam String

  testName String

  overallPercentile Float

  overallScore Float

  varcScore Float
  dilrScore Float
  qaScore   Float

  varcPercentile Float
  dilrPercentile Float
  qaPercentile   Float

  accuracy Float?

  attemptedQuestions Int?

  correctQuestions Int?

  wrongQuestions Int?

  timeTaken Int?

  createdAt        DateTime           @default(now())
  topicPerformance TopicPerformance[]
}

model PracticeQuestion {
  id String @id @default(cuid())

  topic String

  subject String

  difficulty String

  source String

  questionUrl String

  explanationUrl String
}

model TopicPerformance {
  id String @id @default(cuid())

  userId String
  user   user   @relation(fields: [userId], references: [id], onDelete: Cascade)

  mockTestId String
  mockTest   MockTest @relation(fields: [mockTestId], references: [id], onDelete: Cascade)

  section String

  topic String

  questionsAttempted Int

  correct Int

  wrong Int

  accuracy Float

  percentile Float?

  averageTime Float?

  difficulty String?

  createdAt DateTime @default(now())
}

model Resource {
  id String @id @default(cuid())

  topic String

  section String

  type String

  title String

  description String?

  url String

  difficulty String?

  createdAt DateTime @default(now())
}

model StudyResource {
  id String @id @default(cuid())

  title String

  topic String

  section String

  type String

  difficulty String?

  source String?

  url String

  description String?

  createdAt DateTime @default(now())
}

model StudyTask {
  id String @id @default(cuid())

  studyPlanId String
  studyPlan studyplan @relation(fields: [studyPlanId], references: [id])

  userId String
  user user @relation(fields: [userId], references: [id])

  subject String
  topic String

  priority String

  duration Int

  status String @default("PENDING")

  resources Json?

  startedAt DateTime?
  completedAt DateTime?
  skippedAt DateTime?

  createdAt DateTime @default(now())
}

model MockLibrary {
  id              String   @id @default(cuid())
  exam            String
  category        String
  section         String?
  topic           String?
  title           String
  difficulty      String
  duration        Int
  totalQuestions  Int
  isPremium       Boolean  @default(false)
  isActive        Boolean  @default(true)

  questions        MockQuestion[]
  attempts         MockAttempt[]

  createdAt DateTime @default(now())
}

model MockQuestion {
  id              String   @id @default(cuid())

  mockId          String
  mock            MockLibrary @relation(fields: [mockId], references: [id], onDelete: Cascade)

  question        String

  optionA         String
  optionB         String
  optionC         String
  optionD         String

  correctAnswer   String
  explanation     String?

  marks           Float @default(3)
  negativeMarks   Float @default(1)

  difficulty      String

  createdAt       DateTime @default(now())
}

model MockAttempt {
  id            String @id @default(cuid())

  userId        String

  mockId        String
  mock          MockLibrary @relation(fields: [mockId], references: [id], onDelete: Cascade)

  score         Float @default(0)
  percentile    Float @default(0)

  correct       Int @default(0)
  wrong         Int @default(0)
  skipped       Int @default(0)

  accuracy      Float @default(0)

  startedAt     DateTime @default(now())
  submittedAt   DateTime?
}



